{{ ansible_managed | comment }}
{# Address of an inventory host, read without INJECT_FACTS_AS_VARS:
    ansible_ssh_host, then the gathered default IPv4, then ansible_host, then
    the name itself. #}
{% macro host_addr(h) -%}
{{ hostvars[h]['ansible_ssh_host']
   | default((hostvars[h]['ansible_facts'] | default({})).get('default_ipv4', {}).get('address'), true)
   | default(hostvars[h]['ansible_host'], true)
   | default(h, true) }}
{%- endmacro %}

{% if haproxy_config is defined and haproxy_config | length > 0 %}
{{ haproxy_config }}
{% else %}
global
{% if haproxy_journald | bool %}
    log /dev/log {{ haproxy_log_facility }}
{% else %}
    log 127.0.0.1 {{ haproxy_log_facility }}
{% endif %}
    chroot {{ haproxy_socket_dir }}
    pidfile /var/run/haproxy.pid
    maxconn {{ haproxy_maxconn }}
    user {{ haproxy_user }}
    group {{ haproxy_group }}
    daemon
    hard-stop-after {{ haproxy_hard_stop_after }}
    stats socket {{ haproxy_admin_socket }} mode 660 level admin expose-fd listeners
    stats socket {{ haproxy_socket_dir }}/stats
    ssl-default-bind-ciphers {{ haproxy_ssl_default_bind_ciphers }}
    ssl-default-bind-ciphersuites {{ haproxy_ssl_default_bind_ciphersuites }}
    ssl-default-bind-options ssl-min-ver {{ haproxy_ssl_min_ver }} no-tls-tickets
{% if haproxy_global_extra | length > 0 %}
{{ haproxy_global_extra | indent(4, true) }}
{% endif %}

defaults
    mode {{ haproxy_mode }}
    log global
{% for option in haproxy_options %}
    option {{ option }}
{% endfor %}
    retries {{ haproxy_retries }}
{% if haproxy_timeout_http_request %}
    timeout http-request {{ haproxy_timeout_http_request }}
{% endif %}
    timeout queue {{ haproxy_timeout_check }}
    timeout connect {{ haproxy_timeout_connect }}
    timeout client {{ haproxy_timeout_client }}
    timeout server {{ haproxy_timeout_server }}
{% if haproxy_timeout_http_keep_alive %}
    timeout http-keep-alive {{ haproxy_timeout_http_keep_alive }}
{% endif %}
    timeout check {{ haproxy_timeout_check }}
    maxconn {{ haproxy_maxconn }}
{% for ef in haproxy_errorfiles | default([]) %}
    errorfile {{ ef.code }} {{ ef.path }}
{% endfor %}
{% if haproxy_defaults_extra | length > 0 %}
{{ haproxy_defaults_extra | indent(4, true) }}
{% endif %}

{% if haproxy_stats == true %}
listen stats
    bind {{ haproxy_stats_bind_addr }}:{{ haproxy_stats_port }}
    mode http
    http-request use-service prometheus-exporter if { path /metrics }
    stats enable
    stats auth {{ haproxy_stats_page_user }}:{{ haproxy_stats_page_pass }}
    stats uri {{ haproxy_stats_page_uri }}
    stats realm Haproxy
    stats show-modules
{% if haproxy_stats_admin | bool %}
    stats admin if TRUE
{% endif %}
{% endif %}

{% for frontend in haproxy_frontends %}
frontend {{ frontend.name }}
    bind {{ frontend.address }}:{{ frontend.port }}{% if frontend.ssl is defined and frontend.ssl == true %} ssl{% if frontend.crts is defined and frontend.crts | length > 0 %}{% for crt in frontend.crts %} crt {{ crt }}{% endfor %}{% endif %} ssl-min-ver {{ frontend.ssl_min_ver | default(haproxy_ssl_min_ver) }}{% if frontend.alpn is defined %} alpn {{ frontend.alpn }}{% endif %}{% endif %}

{% if frontend.default_backend is defined %}
    default_backend {{ frontend.default_backend }}
{% endif %}
    mode {{ frontend.mode | default('http') }}
{% if frontend.mode | default('http') == 'http' %}
    option {{ frontend.option | default('httplog') }}
{% else %}
    option {{ frontend.option | default('tcplog') }}
{% endif %}
{% if frontend.redirect_https is defined and frontend.redirect_https %}
    http-request redirect scheme https unless { ssl_fc }
{% endif %}
{% for acl in frontend.acls | default([]) %}
    acl {{ acl }}
{% endfor %}
{% for rule in frontend.http_request_rules | default([]) %}
    http-request {{ rule }}
{% endfor %}
{% for rule in frontend.http_response_rules | default([]) %}
    http-response {{ rule }}
{% endfor %}
{% for ub in frontend.use_backends | default([]) %}
    use_backend {{ ub.backend }} {{ ub.condition }}
{% endfor %}
{% if frontend.no_log is defined and frontend.no_log %}
    no log
{% endif %}
{% if frontend.monitor_uri is defined %}
    monitor-uri {{ frontend.monitor_uri }}
{% endif %}
{% if frontend.monitor_fail is defined %}
    monitor fail {{ frontend.monitor_fail }}
{% endif %}
{% endfor %}

{% for backend in haproxy_backends %}
backend {{ backend.name }}
{% if backend.httpcheck | default(false) | bool or backend.http_check is defined %}
    option httpchk
{% if backend.http_check is defined %}
    http-check send meth {{ backend.http_check.send.method }} uri {{ backend.http_check.send.uri }}
    http-check expect {{ backend.http_check.expect }}
{% elif backend.httpcheck_method is defined or backend.httpcheck_uri is defined %}
    http-check send meth {{ backend.httpcheck_method | default('OPTIONS') }} uri {{ backend.httpcheck_uri | default('/') }}
{% endif %}
{% endif %}
    balance {{ backend.balance | default(haproxy_backend_default_balance) }}
    mode {{ backend.mode | default('http') }}
{% if backend.stick_table is defined %}
    stick-table {{ backend.stick_table }}
{% endif %}
{% if backend.stick_on is defined %}
    stick on {{ backend.stick_on }}
{% endif %}
{% for rule in backend.http_request_rules | default([]) %}
    http-request {{ rule }}
{% endfor %}
{% for rule in backend.http_response_rules | default([]) %}
    http-response {{ rule }}
{% endfor %}
{% if backend.http_send_name_header is defined %}
    http-send-name-header {{ backend.http_send_name_header }}
{% endif %}
{% for server in backend.servers %}
{% if server is mapping and server.name is defined %}
    server {{ server.name }} {{ server.address if server.address is defined else host_addr(server.name) }}:{{ server.port | default(backend.port) }}{% if backend.options is defined %} {{ backend.options | join(' ') }}{% endif %}

{% elif server is mapping %}
    server {{ server.name | default('node' ~ loop.index) }} {{ server.address }}:{{ server.port | default(backend.port) }}{% if backend.options is defined %} {{ backend.options | join(' ') }}{% endif %}

{% else %}
    server {{ server }} {{ host_addr(server) }}:{{ backend.port }}{% if backend.options is defined %} {{ backend.options | join(' ') }}{% endif %}

{% endif %}
{% endfor %}
{% endfor %}

{% for listen in haproxy_listens %}
listen {{ listen.name }}
    bind {{ listen.address | default('*') }}:{{ listen.listen_port | default(listen.port) }}{% if listen.ssl is defined and listen.ssl == true %} ssl{% if listen.crts is defined and listen.crts | length > 0 %}{% for crt in listen.crts %} crt {{ crt }}{% endfor %}{% endif %} ssl-min-ver {{ listen.ssl_min_ver | default(haproxy_ssl_min_ver) }}{% endif %}

{% if listen.httpcheck | default(false) | bool or listen.http_check is defined %}
    option httpchk
{% if listen.http_check is defined %}
    http-check send meth {{ listen.http_check.send.method }} uri {{ listen.http_check.send.uri }}
    http-check expect {{ listen.http_check.expect }}
{% elif listen.httpcheck_method is defined or listen.httpcheck_uri is defined %}
    http-check send meth {{ listen.httpcheck_method | default('OPTIONS') }} uri {{ listen.httpcheck_uri | default('/') }}
{% endif %}
{% endif %}
    balance {{ listen.balance | default(haproxy_listen_default_balance) }}
    mode {{ listen.mode | default('tcp') }}
{% for rule in listen.http_request_rules | default([]) %}
    http-request {{ rule }}
{% endfor %}
{% for rule in listen.http_response_rules | default([]) %}
    http-response {{ rule }}
{% endfor %}
{% for server in listen.servers %}
{% if server is mapping and server.name is defined %}
    server {{ server.name }} {{ server.address if server.address is defined else host_addr(server.name) }}:{{ server.port | default(listen.port) }}{% if listen.options is defined %} {{ listen.options | join(' ') }}{% endif %}

{% elif server is mapping %}
    server {{ server.name | default('node' ~ loop.index) }} {{ server.address }}:{{ server.port | default(listen.port) }}{% if listen.options is defined %} {{ listen.options | join(' ') }}{% endif %}

{% else %}
    server {{ server }} {{ host_addr(server) }}:{{ listen.port }}{% if listen.options is defined %} {{ listen.options | join(' ') }}{% endif %}

{% endif %}
{% endfor %}
{% endfor %}

{% for resolver in haproxy_resolvers | default([]) %}
resolvers {{ resolver.name }}
{% for ns in resolver.nameservers %}
    nameserver {{ ns }}
{% endfor %}
{% endfor %}

{% if haproxy_custom_sections | length > 0 %}
{{ haproxy_custom_sections }}
{% endif %}
{% endif %}
